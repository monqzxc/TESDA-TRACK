# Caddy obtains and renews HTTPS certificates for $DOMAIN automatically (localhost uses a local CA).
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# The API is public for signed-in clients and API docs; /health stays internal.
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:8501
	}
}
