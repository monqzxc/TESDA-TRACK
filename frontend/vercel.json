{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://54-251-42-9.sslip.io/api/:path*"
    },
    {
      "source": "/((?!assets/|fonts/|img/).*)",
      "destination": "/index.html"
    }
  ]
}
