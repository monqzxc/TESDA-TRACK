# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Shared --------------------------------------------------------------------
# Signs login tokens. At least 32 characters.
SECRET_KEY=

# --- PostgreSQL in Docker (docker-compose.dev.yml locally, docker-compose.yml on the server) ---
# Both passwords are applied only when the database volume is first created.
# PostgreSQL superuser password (only used inside the db container).
POSTGRES_PASSWORD=
# Password for the non-superuser tesda_track role the API connects with.
APP_DB_PASSWORD=

# --- Server only (docker-compose.yml) --------------------------------------------
# Public domain name; Caddy fetches its HTTPS certificate automatically. Use localhost to try it locally.
DOMAIN=localhost
# Host ports Caddy publishes. To try the stack locally while another server holds 80/443, use
# DOMAIN=http://localhost (plain HTTP, no redirect to 443) with HTTP_PORT=8080, then open http://localhost:8080.
# HTTP_PORT=80
# HTTPS_PORT=443
# API only, with the React app on Vercel (see README, "API only"):
# COMPOSE_FILE=docker-compose.yml:docker-compose.api.yml

# --- Local development (API, Streamlit and tests run on your machine) -------------
# The dev database from docker-compose.dev.yml listens on 127.0.0.1:5433. Replace CHANGE_ME with APP_DB_PASSWORD.
DATABASE_URL=postgresql+psycopg://tesda_track:CHANGE_ME@127.0.0.1:5433/tesda_track
# Tests drop and recreate this database's schema; its name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://tesda_track:CHANGE_ME@127.0.0.1:5433/tesda_track_test
API_BASE_URL=http://127.0.0.1:8000

# --- Semantic search (optional; defaults shown) -----------------------------------
# Local development: where the embedding model is downloaded (about 470 MB). Docker images include it.
EMBEDDING_CACHE_DIR=.models
# A fine-tuned model replaces the default: set both. EMBEDDING_MODEL must be its own name (never the base model's), EMBEDDING_MODEL_PATH is its folder (relative
# paths start at the repository root; in Docker use /app/finetuned/<folder>). Run `embeddings sync` after changing it.
# Production serves v6-colab; download and calibrate it using backend/models/README.md (it is published without a
# calibration.json). Its calibration.json replaces the SEMANTIC_Z_* and MATCH_* values below. v3, the 21 Oct 2026
# pilot decision, stays published for rollback: use tesda-e5-small-v3 in all three values.
EMBEDDING_MODEL=tesda-track/tesda-e5-small-v6-colab
EMBEDDING_MODEL_PATH=backend/models/tesda-e5-small-v6-colab
# When running Docker, keep the host path above and set its container path separately:
DOCKER_EMBEDDING_MODEL_PATH=/app/finetuned/tesda-e5-small-v6-colab
# SEMANTIC_SEARCH_ENABLED=true
# SEMANTIC_Z_FLOOR=3.0
# SEMANTIC_Z_CEILING=5.0
# MATCH_WEIGHT_KEYWORD=0.5
# RANKING_WEIGHTS__SEMANTIC=0.5
# RANKING_WEIGHTS__PROXIMITY=0.2
# RANKING_WEIGHTS__ASSESSMENT=0.15
# RANKING_WEIGHTS__SCHEDULE=0.1
# RANKING_WEIGHTS__PREFERENCE=0.05

# Structured assessments use a separate provisional policy; values must add up to 1.
# PERSONALIZATION_WEIGHTS__INTEREST=0.35
# PERSONALIZATION_WEIGHTS__SKILL=0.25
# PERSONALIZATION_WEIGHTS__CAREER=0.15
# PERSONALIZATION_WEIGHTS__LOCATION=0.15
# PERSONALIZATION_WEIGHTS__PREFERENCE=0.10

# --- Partner MCP server (TESDA Skill Passport, BSRS; see docs/mcp/partner-onboarding.md) ---
# The address partners reach the API at. It is the token issuer, and the MCP endpoint refuses requests for any other
# host (HTTP 421). Docker defaults it to https://$DOMAIN; locally it is http://localhost:8000.
# PUBLIC_BASE_URL=https://tesda-track.example.ph
# Signs partner access tokens (at least 32 characters). Unset, tokens are derived from SECRET_KEY.
# MCP_TOKEN_SECRET=
# Turns the whole MCP server and its token endpoint off when false.
# MCP_ENABLED=true
# Days of per-call usage detail kept before it is folded into daily counts.
# MCP_CALL_LOG_RETENTION_DAYS=180
# The earliest quarter get_qualification_demand answers for.
# MCP_DEMAND_EARLIEST_QUARTER=2025-Q1

# --- Skills Bridge MCP (enabled by default; read-only) ---------------------------
# SKILLS_BRIDGE_MCP_ENABLED=true
# SKILLS_BRIDGE_MCP_URL=https://mcp.skills-bridge.ph/mcp
# Skills Bridge requires sign-in with the OAuth client credentials grant. Set the client issued to TESDA
# Track; without it every Skills Bridge lookup fails.
SKILLS_BRIDGE_CLIENT_ID=
SKILLS_BRIDGE_CLIENT_SECRET=
# SKILLS_BRIDGE_TOKEN_URL=https://skills-bridge.ph/oauth/token
# A fixed bearer token instead of the client credentials (ignored when they are set):
# SKILLS_BRIDGE_MCP_TOKEN=
# SKILLS_BRIDGE_TIMEOUT_SECONDS=10
# Responses are cached in PostgreSQL (0 turns caching off) and deleted within 10 minutes of expiring:
# SKILLS_BRIDGE_CACHE_TTL_SECONDS=3600
# Lookups per minute for each client address (IPv6: per /64), and uncached lookups per minute sent by
# everyone together. Over either limit the API answers 429 with a Retry-After header. Learners sharing one
# public address, such as a training center's network, share the first limit; raise it for such sites.
# SKILLS_BRIDGE_RATE_LIMIT_PER_MINUTE=20
# SKILLS_BRIDGE_UPSTREAM_PER_MINUTE=120
# Legacy REST adapter (separate from MCP; leave unset unless provisioned):
# SKILLS_BRIDGE_BASE_URL=
# SKILLS_BRIDGE_API_TOKEN=

# --- Directions on the center map (optional; default shown) -----------------------
# When a learner shares their location (rounded to about 1 km) and asks for directions, the web app asks this
# OSRM server for the road route. The API asks it for routes (GET /api/v1/routes), and so does the Streamlit app
# until it's retired. The default is the free OpenStreetMap router run by FOSSGIS: one request a second, and it
# keeps requests in its logs. Point this at your own OSRM server to keep locations in house, or set it empty to
# send Directions to Google Maps instead.
# ROUTING_URL=https://routing.openstreetmap.de/routed-car

# --- Recommendation feedback (default shown) -------------------------------------------
# Answers to "Are you satisfied with this recommendation?" per minute for each client address. Learners sharing one
# public address, such as a training center's network, share the limit; raise it for such sites.
# FEEDBACK_RATE_LIMIT_PER_MINUTE=30

# --- Career Map supply and demand (optional; docs/explore-demand.md) ---------------------
# The analysis under the Career Map is written by fixed rules from the recorded counts. Claude can rewrite it as a
# short paragraph: set both values below. Turning it on sends the qualification's name, region names and the public
# counts to Anthropic's API; never a learner's words, account or location. Each selection is written once and kept
# for a week, and the rules' own words are shown whenever Claude can't be reached.
# OUTLOOK_AI_SUMMARY_ENABLED=false
# ANTHROPIC_API_KEY=
# OUTLOOK_SUMMARY_MODEL=claude-opus-5-5
# New AI summaries per minute, for each client address and for everyone together.
# OUTLOOK_SUMMARY_RATE_LIMIT_PER_MINUTE=6
# OUTLOOK_SUMMARY_UPSTREAM_PER_MINUTE=30
# A demo whose only centers are the seed's example sites can count them as supply, so the map has something to
# compare; the analysis then says so. Leave off wherever real registry records are loaded.
# OUTLOOK_INCLUDE_EXAMPLE_SITES=false

# --- Center map tiles (optional) ---------------------------------------------------
# A CARTO basemaps key (https://carto.com/basemaps/apikey) gives the center map its default "Voyager" style.
# The key is sent to learners' browsers with every tile request, so restrict it to your domain in CARTO. The API
# hands it to the React app (GET /api/v1/client-config), and the Streamlit app reads it directly until it's retired.
# Without it the map uses OpenStreetMap tiles.
# CARTO_API=

# --- Center map: vector tiles and 3D buildings (optional; docs/center-map.md) ----------
# With vector tiles and a browser that has WebGL 2, the center map is drawn by MapLibre: sharper labels, light and
# dark styles drawn from the app's colors, and 3D buildings where OpenStreetMap records their heights. Without vector
# tiles, without WebGL 2, or if MapLibre fails, the map stays on Leaflet and the raster tiles above.
# A MapTiler key (https://cloud.maptiler.com/account/keys/). Like the CARTO key it is sent to learners' browsers with
# every tile request: create a key for this site only and restrict it to your domains in MapTiler. Never put a
# private credential here.
# MAPTILER_KEY=
# Or any OpenMapTiles-schema vector tiles instead of MapTiler, e.g. your own tile server: its TileJSON address. Labels
# are drawn in the app's own font, so no font server is needed. Add the tile host to connect-src in frontend/Caddyfile.
# MAP_TILES_URL=https://tiles.example.ph/planet
# leaflet keeps the raster map even with vector tiles set (a switch back while MapLibre is new).
# MAP_ENGINE=maplibre
# 3D buildings are offered only where the tiles record building heights; false turns them off everywhere.
# MAP_3D_ENABLED=true

# --- TESDA Skill Passport sign-in (optional) -------------------------------------
# Lets TSP open TESDA-TRACK in an iframe or WebView already signed in (31-TRACKER_IFRAME_INTEGRATION.md).
# Hercules issues the client; set all three or none. The secret stays on the server: never put it in frontend/.
HERCULES_BASE_URL=
TRACKER_CLIENT_ID=
TRACKER_CLIENT_SECRET=
# HERCULES_TIMEOUT_SECONDS=10
# Turns on signing in from TSP's WebView. Leave off until Hercules confirms sso_id is permanent.
# TSP_SIGN_IN_ENABLED=false
# Shows qualifications suggested from the TSP profile on the webview's entry page. Leave off until the suggestion
# release gates pass (docs/evaluation-and-release-checks.md#profile-only-suggestions).
# TSP_SUGGESTIONS_ENABLED=false
